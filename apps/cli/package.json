{
  "name": "@patch/cli",
  "version": "0.1.0",
  "description": "The terminal window into Patch Cloud",
  "license": "MIT",
  "author": "Adam Parszewski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xcrrr/ptch.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/xcrrr/ptch#readme",
  "bugs": {
    "url": "https://github.com/xcrrr/ptch/issues"
  },
  "type": "module",
  "bin": {
    "ptch": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "cli",
    "coding-agent",
    "ai",
    "terminal",
    "developer-tools"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "screenshots": "tsx scripts/e2e/screenshots.ts",
    "logo": "tsx scripts/logo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chalk": "^5.6.0",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "ignore": "^7.0.5",
    "ink": "^6.8.0",
    "marked": "^18.1.0",
    "picomatch": "^4.0.3",
    "react": "^19.2.0",
    "string-width": "^8.1.0",
    "tinyglobby": "^0.2.15",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@patch/cloud-protocol": "workspace:*",
    "@patch/core": "workspace:*",
    "@patch/provider-anthropic": "workspace:*",
    "@patch/shared": "workspace:*",
    "@types/react": "^19.2.0",
    "@xterm/headless": "^6.0.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  }
}
